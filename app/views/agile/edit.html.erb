<% agile_update_form %>

<div <%= agile_form_id %>>
  <%= agile_head_for_form %>
  <%= agile_dialog_title agile_edit_title() %>

  <%= form_tag( @form_params, method: :put, id: AgileHelper.form_param(params) || AgileHelper.table_param(params),
                class: 'agile_form', multipart: @form['form']['multipart'], window_close: params[:window_close] ) do %>
    <%= render partial: 'form' %>
  <% end %>
</div>

<div id="popup" style="display: none;"></div>

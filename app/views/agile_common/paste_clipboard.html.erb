
<%= agile_dialog_title t('agile.paste_title') %>

<div class="ar-form-frame"><br>
  <span class="ar-link-ajax" data-request="post" title="<%= t('agile.paste_clipboard') %>"
        data-url="<%= url_for(controller: 'agile', action: 'paste_clipboard') %>"><%= t('agile.paste_clipboard') %>
  </span>
  
  <hr><br>
  <div id="result"></div>
  <%= form_tag do %>
    <label><b><%= t('agile.paste_update') %>:</b></label><%= check_box('', 'do_update') %><br><br>

    <label><b>Data:</b></label><br>
  <%= text_area('', 'data',{size: '150x40'}) %><br>
  <% end %>
</div>